{
  "name": "@vexora/database",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite schema, migrations, and repositories via Drizzle ORM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vexora/shared": "workspace:*",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
