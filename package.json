{
  "name": "alpha-terminal",
  "private": true,
  "version": "0.1.0",
  "description": "Alpha Terminal — local-first crypto market terminal",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter @alpha/shared --filter @alpha/server --filter @alpha/web dev",
    "dev:turbo": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:all": "pnpm --filter @alpha/shared build && pnpm --filter @alpha/server build && pnpm --filter @alpha/web build",
    "test": "pnpm -r --if-present test",
    "test:turbo": "turbo run test",
    "lint": "pnpm -r --if-present lint",
    "lint:turbo": "turbo run lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:turbo": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@nestjs/core", "@nestjs/common"]
  }
}
