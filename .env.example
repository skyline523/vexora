# Server
HOST=127.0.0.1
PORT=8787
LOCAL_SESSION_TOKEN=dev-token-change-me
DATABASE_URL=file:../../data/vexora.sqlite
DATA_DIR=../../data
LOG_LEVEL=info

# Web
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_WS_URL=ws://127.0.0.1:8787/ws

# USDT-M futures. Direct fapi.binance.com often times out; the server uses
# http://127.0.0.1:7890 automatically when that port is open.
# BINANCE_FUTURES_PROXY=http://127.0.0.1:7890
# BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
# BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
